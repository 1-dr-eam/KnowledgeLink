<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.liuyi.fateqq.mapper.ChatOrderMapper">
    <!-- 根据订单ID获取订单ID做中间商 -->
    <select id="getOrderById" parameterType="int" resultType="java.lang.Integer">
        SELECT id FROM `order` WHERE id = #{orderId}
    </select>

</mapper>
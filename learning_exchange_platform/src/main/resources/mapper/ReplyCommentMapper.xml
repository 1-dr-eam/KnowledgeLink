<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="learning_exchange_platform.mapper.ReplyCommentMapper">

    <insert id="insertReplyComment">
        insert into reply_comment(comment_id,reply_type,reply_comment_id,reply_user_name,content,user_id,user_name,user_avatar)
        values (#{comment_id},#{reply_type},#{reply_comment_id},#{reply_user_name},#{content},#{user_id},#{user_name},#{user_avatar})
    </insert>
    <delete id="deleteReplyCommentsByIds">
        delete from reply_comment where id in #{ids}
    </delete>

    <select id="selectReplyCommentById" resultType="learning_exchange_platform.model.ReplyComment">
        select * from reply_comment where id=#{id}
    </select>

    <select id="selectRepliesByCommentId" resultType="learning_exchange_platform.model.ReplyComment">
        select * from reply_comment where comment_id=#{comment_id} order by create_time desc
    </select>

    <select id="selectRepliesIdByCurrentId" resultType="java.math.BigInteger">
        select * from reply_comment where reply_comment_id=#{current_id}
    </select>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="learning_exchange_platform.mapper.CommentMapper">

    <insert id="insertComment">
        insert into comment (post_id,user_id,user_name,user_avatar,content)
        values (#{post_id}, #{user_id}, #{user_name}, #{user_avatar}, #{content})
    </insert>

    <update id="updateReplyCount">
        update comment set reply_count=#{reply_count} where id=#{id}
    </update>

    <delete id="deleteCommentById">
        delete from comment where id=#{id}
    </delete>
    <!-- 批量删除 -->
    <delete id="deleteCommentsByIds">
        DELETE FROM comment WHERE id IN
        <foreach collection="comment_ids" item="id">
            #{id}
        </foreach>
    </delete>

    <select id="selectCommentById" resultType="learning_exchange_platform.model.Comment">
        select * from comment where id=#{id}
    </select>

    <select id="selectCommentsByPostId" resultType="learning_exchange_platform.model.Comment">
        select * from comment where post_id=#{post_id} order by create_time desc
    </select>

    <select id="countCommentsByPostId" resultType="java.lang.Integer">
        select count(*) from comment where post_id=#{post_id}
    </select>

</mapper>
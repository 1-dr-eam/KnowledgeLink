<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="learning_exchange_platform.mapper.NewsMapper">

    <select id="selectNewsList" resultType="learning_exchange_platform.model.News">
        select * from news limit #{limit}
    </select>

    <select id="selectNewsById" resultType="learning_exchange_platform.model.News">
        select * from news where id=#{id}
    </select>

</mapper>